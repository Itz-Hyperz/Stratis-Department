<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - <%= config.information.name %></title>
    <link rel="icon" type="image/png" href="<%= config.information.logo %>">
    <link href="https://fonts.googleapis.com/css2?family=Kantumruy+Pro:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: "Kantumruy Pro", sans-serif;
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #<%= config.colors.backgroundColor %>;
            color: #fff;
            text-align: center;
        }
        h1 { font-size: 4rem; margin: 0 0 0.5rem; }
        p { opacity: 0.7; margin-bottom: 2rem; }
        a {
            color: #<%= config.colors.buttonTextColor %>;
            background: #<%= config.colors.accentColor %>;
            padding: 0.75rem 1.5rem;
            border-radius: 0.5rem;
            text-decoration: none;
            font-weight: 600;
            text-transform: uppercase;
        }
    </style>
</head>
<body>
    <div>
        <h1>404</h1>
        <p>Page not found.</p>
        <a href="/">Back Home</a>
    </div>
</body>
</html>
